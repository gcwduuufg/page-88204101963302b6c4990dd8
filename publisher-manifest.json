(--ink-soft);font-size: 15px}\n\n    /* ---------- 套餐对比表格 ---------- */\n    .table-scroll {overflow-x: auto;-webkit-overflow-scrolling: touch}\n    table.plans {width: 100%;border-collapse: collapse;min-width: 620px;font-size: 15px}\n    table.plans caption {caption-side: top;text-align: left;font-size: 13px;color: var(--ink-soft);padding-bottom: 10px}\n    table.plans th, table.plans td {border: 1px solid var(--line);padding: 14px 16px;text-align: left;vertical-align: top}\n    table.plans thead th {background: var(--paper);border-bottom: 2px solid var(--ink);font-weight: 800}\n    table.plans thead th.col-featured {background: var(--orange);color: #fff;border-color: var(--orange)}\n    table.plans tbody th {background: var(--wash);font-weight: 600;white-space: nowrap;width: 28%}\n    table.plans td.col-featured {background: var(--orange-wash)}\n    table.plans .price {font-size: 20px;font-weight: 800;display: block}\n    table.plans .annual {font-size: 13px;color: var(--ink-soft);display: block;margin-top: 2px}\n    table.plans .mark {display: inline-block;font-size: 11px;letter-spacing: 0.08em;background: #fff;color: var(--orange-deep);border: 1px solid currentColor;border-radius: 2px;padding: 0 6px;margin-left: 6px;vertical-align: 2px}\n    table.plans ul li {position: relative;padding-left: 16px;margin-bottom: 4px}\n    table.plans ul li::before {content: \"\";position: absolute;left: 0;top: 0.72em;width: 6px;height: 6px;background: var(--orange)}\n\n    /* ---------- 客户端区域 ---------- */\n    .clients-grid {display: grid;grid-template-columns: 1fr;gap: 20px}\n    @media (min-width: 700px) {\n      .clients-grid {grid-template-columns: repeat(2, 1fr)}\n    }\n    .clients-grid .ticket h3 {display: flex;justify-content: space-between;align-items: baseline;gap: 10px}\n    .clients-grid .ticket h3 span {font-size: 12px;font-weight: 500;letter-spacing: 0.08em;color: var(--orange-deep)}\n    .clients-grid .ticket p {color: var(--ink-soft);font-size: 15px;margin-bottom: 10px}\n    .clients-grid .ticket p:last-child {margin-bottom: 0}\n    .notice {margin-top: 26px;border-left: 4px solid var(--orange);background: var(--orange-wash);padding: 14px 18px;font-size: 14px;color: var(--ink-soft)}\n\n    /* ---------- FAQ 双栏问答 ---------- */\n    .faq-grid {display: grid;grid-template-columns: 1fr;gap: 22px 34px}\n    @media (min-width: 800px) {\n      .faq-grid {grid-template-columns: repeat(2, 1fr)}\n    }\n    .faq-item {border-top: 1px dashed var(--line);padding-top: 16px}\n    .faq-item h3 {font-size: 16px;font-weight: 800;margin-bottom: 8px;display: flex;gap: 10px}\n    .faq-item h3 .q {color: var(--orange);font-weight: 800;flex: none}\n    .faq-item p {color: var(--ink-soft);font-size: 15px;margin-bottom: 0}\n\n    /* ---------- 尾部 ---------- */\n    .foot {background: var(--ink);color: #cfd2d8;padding: 40px 0 46px;font-size: 14px}\n    .foot .wrap {display: grid;gap: 14px}\n    .foot strong {color: #fff;font-size: 16px;letter-spacing: 0.02em}\n    .foot a {color: #ffb394;border-bottom-color: rgba(255,179,148,0.5)}\n    .foot a:hover {color: #fff}\n    .foot .meta {color: #9aa0a9;font-size: 13px}\n\n    .to-top {display: inline-block;margin-top: 18px;font-size: 13px;color: var(--ink-soft);border-bottom: 1px dashed currentColor}\n  </style><main>\n\n  \n  <section class=\"band band-top\">\n    <div class=\"wrap\">\n      <span class=\"kicker\">小猪科技 · 订阅说明</span>\n      <h1>先看清单，再决定要不要用 <em>小猪科技</em>。</h1>\n      <p class=\"lede\">这一页把三档方案的价格、设备数量、流量额度与支持方式逐项列清，不堆形容词。往下读，你需要的信息基本都在表里。</p>\n      <nav class=\"jump\" aria-label=\"页内跳转\">\n        <a href=\"#how\">使用说明</a>\n        <a href=\"#plans\">套餐对比</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </section>\n\n  <section class=\"band band-strip\">\n    <div class=\"wrap\" aria-label=\"页面要点\">\n      <span><strong>三档</strong>方案横向对比</span>\n      <span><strong>月付</strong>与年付同页呈现</span>\n      <span><strong>四步</strong>完成上手</span>\n      <span><strong>八问</strong>常见问题作答</span>\n    </div>\n  </section>\n\n  <section class=\"band band-plain\" id=\"start\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>这页在讲什么</h2>\n        <span class=\"note\">读法建议：先看定位，再看表格</span>\n      </div>\n      <div class=\"intro-grid\">\n        <article class=\"ticket\">\n          <span class=\"tag\">定位</span>\n          <h3>按需选档，不打包承诺</h3>\n          <p>小猪科技把方案拆成基础版、旗舰版、团队版三档，差别集中在月流量、同时在线设备数、线路与支持方式。你只需要确认自己属于哪一种使用强度。</p>\n        </article>\n        <article class=\"ticket\">\n          <span class=\"tag\">边界</span>\n          <h3>页面上没有写的，就不算承诺</h3>\n          <p>本页只列出方案信息与使用步骤。关于线路质量、实际速率与可用范围，请以你在客户端内看到的说明和订购页展示为准，本页不做额外保证。</p>\n        </article>\n        <article class=\"ticket\">\n          <span class=\"tag\">比较</span>\n          <h3>三档放在一张表里</h3>\n          <p>横向对比表按行拆开权益，同一行就是同一项，逐行看下来比来回切换卡片更快。旗舰版一列有底色，方便你定位。</p>\n        </article>\n        <article class=\"ticket\">\n          <span class=\"tag\">取舍</span>\n          <h3>年付与月付并列写出</h3>\n          <p>月付适合先试一段时间；年付价在表中单独标出，两者并列显示，方便你算清长期成本。具体结算方式以订购页面为准。</p>\n        </article>\n      </div>\n      <a class=\"to-top\" href=\"#plans\">直接看套餐对比 →</a>\n    </div>\n  </section>\n\n  \n  <section class=\"band band-wash\" id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>使用说明：四步走完</h2>\n        <span class=\"note\">清单式 · 按顺序做即可</span>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <strong>先估一份用量</strong>\n          <span>把每月大致流量、常用设备数量写下来。一台手机加一台电脑属于轻量，家里多设备加上平板就进入中量，团队共享则要考虑上限。</span>\n        </li>\n        <li>\n          <strong>对照表格挑一档</strong>\n          <span>在「套餐对比」里从流量和在线设备数两行开始看，这两项最直接决定你的选择。其余行用来确认流媒体与支持方式是否够用。</span>\n        </li>\n        <li>\n          <strong>完成订购与开通</strong>\n          <span>在订购页面选择月付或年付，确认价格后提交。开通与结算流程以订购页面当时展示的信息为准，本页不代替结算页面。</span>\n        </li>\n        <li>\n          <strong>在设备上配置并试用</strong>\n          <span>依据所购方案支持的系统，在你的设备上完成配置。建议先用几天，观察实际使用感受，再决定是否续期或升档。</span>\n        </li>\n        <li>\n          <strong>需要时再升档</strong>\n          <span>流量或设备数不够用时，优先考虑升到上一档，而不是叠加多份低档方案。团队协作场景直接看团队版的设备上限与专属支持。</span>\n        </li>\n      </ol>\n      <div class=\"notice\">以上为通用步骤。小猪科技的具体开通细节、可用系统与结算方式，请以你实际看到的订购与客户端页面为准。</div>\n    </div>\n  </section>\n\n  \n  <section class=\"band band-plain\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>套餐对比</h2>\n        <span class=\"note\">横向表格 · 同一行即同一项</span>\n      </div>\n      <div class=\"table-scroll\">\n        <table class=\"plans\">\n          价格与权益按下表列出；年付价为对应方案的年度总价。\n          <thead>\n            <tr>\n              <th>项目</th>\n              <th>基础版</th>\n              <th class=\"col-featured\">旗舰版<span class=\"mark\">推荐</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15/月</span></td>\n              <td class=\"col-featured\"><span class=\"price\">¥35/月</span></td>\n              <td><span class=\"price\">¥85/月</span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td><span class=\"annual\">按年付 ¥150/年</span></td>\n              <td class=\"col-featured\"><span class=\"annual\">按年付 ¥350/年</span></td>\n              <td><span class=\"annual\">按年付 ¥850/年</span></td>\n            </tr>\n            <tr>\n              <th>月流量额度</th>\n              <td>100GB</td>\n              <td class=\"col-featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"col-featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路说明</th>\n              <td>普通线路节点池</td>\n              <td class=\"col-featured\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"col-featured\">全节点原生流媒体解锁</td>\n              <td>随方案提供，具体以订购页说明为准</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>标准工单支持</td>\n              <td class=\"col-featured\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>附加能力</th>\n              <td>—</td>\n              <td class=\"col-featured\">—</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人轻度使用，一到两台设备</td>\n              <td class=\"col-featured\">个人多设备使用，对流媒体与线路有要求</td>\n              <td>多人协作或小型团队统一管理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"notice\">表中价格与权益依据方案说明整理。实际结算金额、可用节点与支持响应，以订购页面和你收到的服务说明为准。</div>\n    </div>\n  </section>\n\n  \n  <section class=\"band band-wash\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端与设备</h2>\n        <span class=\"note\">按系统分类 · 未确认处不写下载地址</span>\n      </div>\n      <div class=\"clients-grid\">\n        <article class=\"ticket\">\n          <h3>桌面端 <span>电脑</span></h3>\n          <p>在电脑上使用前，先确认系统版本满足客户端要求，再按订购页面给出的入口完成安装。配置项请按你所用方案对应的说明填写。</p>\n          <p>本页不提供下载地址；可用客户端清单与安装包来源，请以订购页面和官方说明为准。</p>\n        </article>\n        <article class=\"ticket\">\n          <h3>移动端 <span>手机与平板</span></h3>\n          <p>移动设备同样计入同时在线数量。基础版 3 台、旗舰版 5 台、团队版 20 台，建议先算清常开机型的数量再选档。</p>\n          <p>应用获取渠道与可用系统版本，本页不做罗列，以客户端页面展示为准。</p>\n        </article>\n        <article class=\"ticket\">\n          <h3>多设备同时在线 <span>数量规则</span></h3>\n          <p>同时在线指同一时间处于连接状态的设备数量。切换设备、下线一台再连另一台，不计为超出上限。</p>\n          <p>如果经常多台同时使用，直接按上限选档，比事后调整更省事。</p>\n        </article>\n        <article class=\"ticket\">\n          <h3>团队统一管理 <span>协作场景</span></h3>\n          <p>团队版提供 20 台设备上限、VIP 专属高带宽节点与企业定制路由能力，适合需要统一安排账号与线路的多人场景。</p>\n          <p>定制路由的可行范围与配置方式需另行沟通，本页不做具体承诺。</p>\n        </article>\n      </div>\n      <div class=\"notice\">小猪科技的具体客户端名称、支持的系统版本与下载渠道，本页未列出的部分不视为已确认信息。请以订购页与客户端内说明为准。</div>\n    </div>\n  </section>\n\n  \n  <section class=\"band band-plain\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <span class=\"note\">双栏问答 · 八问</span>\n      </div>\n      <div class=\"faq-grid\">\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>三档方案的核心差别是什么？</h3>\n          <p>主要三点：月流量 100GB、300GB、1000GB；同时在线设备 3 台、5 台、20 台；线路与支持方式不同。先看前两项，再判断后两项是否需要。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>月付和年付该怎么选？</h3>\n          <p>还没确定长期使用时，先按月付。确认会持续用，再考虑年付价：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。实际结算以订购页面为准。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>超出流量额度会怎样？</h3>\n          <p>本页只列出各档的月流量额度，未说明超出后的处理方式。请在订购页面确认相关规则，或按你的历史用量预留余量、选择更高一档。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>同时在线的设备数怎么算？</h3>\n          <p>按同一时间处于连接状态的设备数量计算。手机、平板、电脑都计入。先下线一台再接另一台，不会占用两个名额。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>可以先买基础版再升级吗？</h3>\n          <p>可以按升级思路处理：当流量或设备数不够用时，改选上一档，而不是叠加多份低档方案。具体升级路径以订购页面展示为准。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>团队版适合什么规模？</h3>\n          <p>适合需要多人共用、设备较多或希望统一安排线路的场景，设备上限为 20 台，并提供企业定制路由与专属客户经理服务。定制范围需另行沟通。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>客户端从哪里获取？</h3>\n          <p>本页不提供下载地址，也不列举未经确认的客户端清单。请以订购页面和你收到的服务说明中的入口为准。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3><span class=\"q\">问</span>本页内容与实际订购页不一致时怎么办？</h3>\n          <p>以订购页面与实际服务说明为准。本页用于整理方案信息与比较思路，不替代结算页面，也不构成额外承诺。</p>\n        </div>\n      </div>\n      <a class=\"to-top\" href=\"#start\">回到页首读法说明 ↑</a>\n    </div>\n  </section>\n\n  <footer class=\"foot\">\n    <div class=\"wrap\">\n      <strong>小猪科技</strong>\n      <p>本页为订阅方案说明页：列出三档价格与权益、上手步骤、设备规则与常见问题。页内未提供下载地址与结算入口，相关信息请以订购页面为准。</p>\n      <p class=\"meta\">页面内容按方案说明整理，未标注的信息不予推定。价格若有调整，以订购页面展示为准。</p>\n      <p class=\"meta\"><a href=\"#plans\">套餐对比</a> · <a href=\"#clients\">客户端与设备</a> · <a href=\"#faq\">常见问题</a></p>\n    </div>\n  </footer>\n\n</main>",
